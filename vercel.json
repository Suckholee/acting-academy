{
  "outputDirectory": "dist-published",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/admin/editorial",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/editorial.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/editorial-admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/editorial.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/materials",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/consultation",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/ai-audition",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/audition",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/casting",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/audition-edit",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/admin-consultation.js": {
      "includeFiles": "private-assets/consultation/**"
    },
    "api/admin-consultation-notes.js": {
      "maxDuration": 120
    },
    "api/admin-editorial.js": {
      "maxDuration": 60
    },
    "api/admin-editorial-image.js": {
      "maxDuration": 120
    },
    "api/ai-audition.js": {
      "maxDuration": 240
    },
    "api/admin-casting-summary.js": {
      "maxDuration": 120
    },
    "api/casting-maintenance.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/auditions-sitemap.xml",
      "destination": "/api/casting-page?sitemap=1"
    },
    {
      "source": "/auditions",
      "destination": "/api/casting-page"
    },
    {
      "source": "/auditions/:id",
      "destination": "/api/casting-page?id=:id"
    },
    {
      "source": "/journal-sitemap.xml",
      "destination": "/api/journal?sitemap=1"
    },
    {
      "source": "/journal",
      "destination": "/api/journal"
    },
    {
      "source": "/journal/:id",
      "destination": "/api/journal?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/auditions.html",
      "destination": "/auditions",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/casting-maintenance",
      "schedule": "0 15 * * *"
    }
  ]
}
